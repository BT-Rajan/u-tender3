          {
            "type": "TextBody",
            "text": "${data.summary}"
          },
          {
            "type": "TextBody",
            "text": "${data.error_message}"
          },
          {
            "type": "Footer",
            "label": "Publish now",
            "on-click-action": {
              "name": "data_exchange",
              "payload": {
                "tender_id": "${data.tender_id}",
                "option": "publish"
              }
            }
          }
        ]
      }
    },
    {
