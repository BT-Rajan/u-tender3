          {
            "type": "TextBody",
            "text": "${data.details}"
          },
          {
            "type": "TextBody",
            "text": "${data.error_message}"
          },
          {
            "type": "RadioButtonsGroup",
            "label": "Action",
            "name": "details_choice",
            "required": true,
            "data-source": "${data.actions}"
          },
          {
            "type": "RadioButtonsGroup",
            "label": "Confirm (only for no award or cancel)",
            "name": "confirm",
            "required": false,
            "data-source": [
              {
                "id": "yes",
                "title": "Yes, I confirm"
              },
              {
                "id": "no",
                "title": "No"
              }
            ]
          },
          {
            "type": "Footer",
            "label": "Continue",
            "on-click-action": {
              "name": "data_exchange",
              "payload": {
                "tender_id": "${data.tender_id}",
                "action": "${form.details_choice}",
                "confirm": "${form.confirm}"
              }
            }
          }
        ]
      }
    },
