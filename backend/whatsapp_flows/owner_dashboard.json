{
  "version": "7.0",
  "data_api_version": "3.0",
  "routing_model": {
    "MENU": [
      "DOCUMENTS",
      "COMING_SOON",
      "EXPIRED",
      "CREATE_TENDER",
      "MY_TENDERS"
    ],
    "DOCUMENTS": [
      "LINKS_SENT"
    ],
    "CREATE_TENDER": [
      "REVIEW",
      "DONE"
    ],
    "REVIEW": [
      "DONE"
    ],
    "MY_TENDERS": [
      "TENDER_DETAILS",
      "DONE"
    ],
    "TENDER_DETAILS": [
      "CREATE_TENDER",
      "AMEND",
      "DONE",
      "OFFERS"
    ],
    "AMEND": [
      "DONE"
    ]
  },
  "screens": [
    {
      "id": "MENU",
      "title": "U-Tender",
      "terminal": false,
      "data": {
        "greeting": {
          "type": "string",
          "__example__": "Hello Layla"
        },
        "status": {
          "type": "string",
          "__example__": "Your account is verified and active."
        },
        "error_message": {
          "type": "string",
          "__example__": "Choose one option."
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextHeading",
            "text": "${data.greeting}"
          },
          {
            "type": "TextBody",
            "text": "${data.status}"
          },
          {
            "type": "TextBody",
            "text": "${data.error_message}"
          },
          {
            "type": "RadioButtonsGroup",
            "label": "What would you like to do?",
            "name": "choice",
            "required": true,
            "data-source": [
              {
                "id": "create_tender",
                "title": "Create a tender"
              },
              {
                "id": "my_tenders",
                "title": "My tenders"
              },
              {
                "id": "received_offers",
                "title": "Received offers"
              },
              {
                "id": "my_documents",
                "title": "My documents"
              }
            ]
          },
          {
            "type": "Footer",
            "label": "Open",
            "on-click-action": {
              "name": "data_exchange",
              "payload": {
                "choice": "${form.choice}"
              }
            }
          }
        ]
      }
    },
    {
      "id": "DOCUMENTS",
      "title": "My documents",
      "terminal": false,
      "data": {
        "checklist": {
          "type": "string",
          "__example__": "Civil ID: Upload needed"
        },
        "error_message": {
          "type": "string",
          "__example__": "Try again."
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextBody",
            "text": "${data.checklist}"
          },
          {
            "type": "TextBody",
            "text": "We will send a secure upload link for each document that needs a file. Each link works once."
          },
          {
            "type": "Footer",
            "label": "Send upload links",
            "on-click-action": {
              "name": "data_exchange",
              "payload": {
                "intent": "send_links"
              }
            }
          }
        ]
      }
    },
    {
      "id": "LINKS_SENT",
      "title": "Upload links sent",
      "terminal": true,
      "success": true,
      "data": {
        "message": {
          "type": "string",
          "__example__": "We sent 2 upload links to this chat."
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextBody",
            "text": "${data.message}"
          },
          {
            "type": "Footer",
            "label": "Close",
            "on-click-action": {
              "name": "complete",
              "payload": {
                "status": "links_sent"
              }
            }
          }
        ]
      }
    },
    {
      "id": "COMING_SOON",
      "title": "Coming soon",
      "terminal": true,
      "success": true,
      "data": {
        "message": {
          "type": "string",
          "__example__": "This section is coming soon."
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextBody",
            "text": "${data.message}"
          },
          {
            "type": "Footer",
            "label": "Close",
            "on-click-action": {
              "name": "complete",
              "payload": {
                "status": "closed"
              }
            }
          }
        ]
      }
    },
    {
      "id": "EXPIRED",
      "title": "Form expired",
      "terminal": true,
      "success": false,
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextBody",
            "text": "This dashboard has expired. Send any message to U-Tender to open it again."
          },
          {
            "type": "Footer",
            "label": "Close",
            "on-click-action": {
              "name": "complete",
              "payload": {
                "status": "expired"
              }
            }
          }
        ]
      }
    },
