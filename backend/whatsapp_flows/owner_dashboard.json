          "__example__": "id"
        },
        "summary": {
          "type": "string",
          "__example__": "Title: Villa renovation"
        },
        "error_message": {
          "type": "string",
          "__example__": ""
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
