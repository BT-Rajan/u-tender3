{
  "version": "7.0",
  "data_api_version": "3.0",
  "routing_model": {
    "MENU": ["MENU", "COMING_SOON", "EXPIRED"]
  },
  "screens": [
    {
      "id": "MENU",
      "title": "U-Tender",
      "terminal": false,
      "data": {
        "greeting": { "type": "string", "__example__": "Hello Omar" },
        "status": { "type": "string", "__example__": "Your account is verified and active." },
        "error_message": { "type": "string", "__example__": "Choose one option." }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          { "type": "TextHeading", "text": "${data.greeting}" },
          { "type": "TextBody", "text": "${data.status}" },
          { "type": "TextBody", "text": "${data.error_message}" },
          {
            "type": "RadioButtonsGroup",
            "label": "What would you like to do?",
            "name": "choice",
            "required": true,
            "data-source": [
              { "id": "browse_projects", "title": "Browse projects" },
              { "id": "my_offers", "title": "My offers" },
              { "id": "my_documents", "title": "My documents" },
              { "id": "my_awards", "title": "My awards" }
            ]
          },
          {
            "type": "Footer",
            "label": "Open",
            "on-click-action": {
              "name": "data_exchange",
              "payload": {
                "choice": "${form.choice}"
              }
            }
          }
        ]
      }
    },
    {
      "id": "COMING_SOON",
      "title": "Coming soon",
      "terminal": true,
      "success": true,
      "data": {
        "message": { "type": "string", "__example__": "This section is coming soon." }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          { "type": "TextBody", "text": "${data.message}" },
          {
            "type": "Footer",
            "label": "Close",
            "on-click-action": {
              "name": "complete",
              "payload": { "status": "closed" }
            }
          }
        ]
      }
    },
    {
      "id": "EXPIRED",
      "title": "Form expired",
      "terminal": true,
      "success": false,
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          { "type": "TextBody", "text": "This dashboard has expired. Send any message to U-Tender to open it again." },
          {
            "type": "Footer",
            "label": "Close",
            "on-click-action": {
              "name": "complete",
              "payload": { "status": "expired" }
            }
          }
        ]
      }
    }
  ]
}
