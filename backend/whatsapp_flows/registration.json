{
  "version": "7.0",
  "data_api_version": "3.0",
  "routing_model": {
    "SPLASH": [
      "REGISTER",
      "EXPIRED"
    ],
    "REGISTER": [
      "RESULT_OK",
      "RESULT_ERROR"
    ],
    "RESULT_OK": [
      "SUMMARY"
    ],
    "SUMMARY": [
      "THANKS"
    ]
  },
  "screens": [
    {
      "id": "SPLASH",
      "title": "U-Tender",
      "terminal": false,
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Image",
            "src": "data:image/png;base64,",
            "width": 120,
            "height": 120,
            "scale-type": "contain",
            "alt-text": "U-Tender logo"
          },
          {
            "type": "TextHeading",
            "text": "U-Tender"
          },
          {
            "type": "Footer",
            "label": "Get started",
            "on-click-action": {
              "name": "navigate",
              "next": {
                "type": "screen",
                "name": "REGISTER"
              },
              "payload": {}
            }
          }
        ]
      }
    },
    {
      "id": "REGISTER",
      "title": "Create your account",
      "terminal": false,
      "data": {
        "full_name": {
          "type": "string",
          "__example__": "Layla Al-Sabah"
        },
        "address": {
          "type": "string",
          "__example__": "Block 4, Street 12, Salmiya, Kuwait"
        },
        "error_message": {
          "type": "string",
          "__example__": "Enter your address."
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextBody",
            "text": "${data.error_message}"
          },
          {
            "type": "TextInput",
            "label": "Full name or company name",
            "name": "full_name",
            "input-type": "text",
            "required": true,
            "min-chars": 2,
            "max-chars": 120,
            "init-value": "${data.full_name}"
          },
          {
            "type": "TextArea",
            "label": "Address",
            "name": "address",
            "required": true,
            "max-length": 255,
            "init-value": "${data.address}"
          },
          {
            "type": "RadioButtonsGroup",
            "label": "I am a",
            "name": "role",
            "required": true,
            "data-source": [
              {
                "id": "owner",
                "title": "Building owner"
              },
              {
                "id": "contractor",
                "title": "Contractor"
              }
            ]
          },
          {
            "type": "Footer",
            "label": "Create account",
            "on-click-action": {
              "name": "data_exchange",
              "payload": {
                "full_name": "${form.full_name}",
                "address": "${form.address}",
                "role": "${form.role}"
              }
            }
          }
        ]
      }
    },
    {
      "id": "RESULT_OK",
      "title": "Account created",
      "terminal": false,
      "data": {
        "reference": {
          "type": "string",
          "__example__": "9f1c2a7e-3b4d-4e8f-9a10-2c5d6e7f8a9b"
        },
        "capabilities": {
          "type": "string",
          "__example__": "- Browse open projects"
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextHeading",
            "text": "Registration successful"
          },
          {
            "type": "TextBody",
            "text": "Your U-Tender ID:\n${data.reference}"
          },
          {
            "type": "Footer",
            "label": "Continue",
            "on-click-action": {
              "name": "navigate",
              "next": {
                "type": "screen",
                "name": "SUMMARY"
              },
              "payload": {
                "capabilities": "${data.capabilities}"
              }
            }
          }
        ]
      }
    },
    {
      "id": "SUMMARY",
      "title": "What you can do",
      "terminal": false,
      "data": {
        "capabilities": {
          "type": "string",
          "__example__": "- Browse open projects"
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextBody",
            "text": "${data.capabilities}"
          },
          {
            "type": "Footer",
            "label": "Next",
            "on-click-action": {
              "name": "navigate",
              "next": {
                "type": "screen",
                "name": "THANKS"
              },
              "payload": {}
            }
          }
        ]
      }
    },
    {
      "id": "THANKS",
      "title": "Thank you",
      "terminal": true,
      "success": true,
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextHeading",
            "text": "Thank you for joining U-Tender"
          },
          {
            "type": "TextBody",
            "text": "Send the word utender any time to open your dashboard."
          },
          {
            "type": "Footer",
            "label": "Done",
            "on-click-action": {
              "name": "complete",
              "payload": {
                "status": "registered"
              }
            }
          }
        ]
      }
    },
    {
      "id": "RESULT_ERROR",
      "title": "Registration not completed",
      "terminal": true,
      "success": false,
      "data": {
        "error_message": {
          "type": "string",
          "__example__": "This number already has an account."
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextHeading",
            "text": "Registration not completed"
          },
          {
            "type": "TextBody",
            "text": "${data.error_message}"
          },
          {
            "type": "Footer",
            "label": "Close",
            "on-click-action": {
              "name": "complete",
              "payload": {
                "status": "not_completed"
              }
            }
          }
        ]
      }
    },
    {
      "id": "EXPIRED",
      "title": "Form expired",
      "terminal": true,
      "success": false,
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextBody",
            "text": "This form has expired. Send the word utender to start again."
          },
          {
            "type": "Footer",
            "label": "Close",
            "on-click-action": {
              "name": "complete",
              "payload": {
                "status": "expired"
              }
            }
          }
        ]
      }
    }
  ]
}
