# --- Database ---
# MySQL or MariaDB only. Required: no default. The app refuses to start while this still says CHANGE_ME.
DATABASE_URL=mysql+pymysql://CHANGE_ME:CHANGE_ME@127.0.0.1:3306/utender

# --- Auth ---
# Required. At least 32 random characters. Generate with: openssl rand -hex 32
JWT_SECRET=CHANGE_ME
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_MINUTES=30
JWT_REFRESH_TTL_DAYS=30

# --- File storage: local (default) or s3 ---
# Switching backends is config-only — no code change.
STORAGE_BACKEND=local
STORAGE_ROOT=./storage
# Required. A different random value, at least 32 characters.
STORAGE_SIGNING_SECRET=CHANGE_ME

# Only used when STORAGE_BACKEND=s3
S3_BUCKET_DRAWINGS=project-drawings
S3_BUCKET_DOCUMENTS=contractor-documents
S3_BUCKET_OWNER_DOCUMENTS=owner-documents
S3_REGION=us-east-1
S3_ENDPOINT_URL=
S3_OBJECT_PREFIX=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SIGNED_URL_DEFAULT_EXPIRY_SECONDS=86400

# --- Stripe ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_MONTHLY=
STRIPE_PRICE_ID_ANNUAL=

# --- Email (Resend) ---
RESEND_API_KEY=
EMAIL_FROM=U-Tender <notifications@u-tender.example>

# --- Deadline-reminder cron ---
# Required. Random, at least 32 characters.
CRON_SECRET=CHANGE_ME

# --- URLs ---
APP_URL=http://localhost:5173
API_URL=http://localhost:8000

# Comma-separated list of origins allowed to call this API with credentials
CORS_ORIGINS=http://localhost:5173

# --- Request limits ---
# Rejected before the body is read into memory (Content-Length check).
MAX_UPLOAD_MB=50
